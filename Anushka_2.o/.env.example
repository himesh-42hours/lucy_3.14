OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
ANUSHKA_TTS_ENGINE=pyttsx3
ANUSHKA_TTS_MODEL=gpt-4o-mini-tts
ANUSHKA_TTS_VOICE=nova
ANUSHKA_TTS_INSTRUCTIONS=Speak warmly, naturally, and conversationally, like a friendly humanoid robot talking to visitors.
ANUSHKA_TTS_SPEED=0.95
ANUSHKA_TTS_VOICE_ID=english+f3
ANUSHKA_TTS_RATE=145
ANUSHKA_TTS_VOLUME=0.95

ANUSHKA_MIC_DEVICE_INDEX=
ANUSHKA_MIC_NAME_HINT=ReSpeaker
ANUSHKA_CAMERA_INDEX=0
ANUSHKA_CAMERA_NAME_HINT=Kreo
ANUSHKA_ENABLE_MONITORING=true
ANUSHKA_ENABLE_VISION=false
ANUSHKA_MONITOR_URL=http://10.21.69.5:3000

ANUSHKA_LEFT_ARM_MEGA_ID=usb-Arduino_LeftArm
ANUSHKA_RIGHT_ARM_MEGA_ID=usb-Arduino_RightArm
ANUSHKA_HEAD_MEGA_ID=usb-Arduino_Head
ANUSHKA_BASE_MEGA_ID=usb-Arduino_Base

# Direct path fallback still works if you prefer stable /dev/serial/by-id paths.
# ANUSHKA_LEFT_ARM_MEGA_PORT=/dev/serial/by-id/...
# ANUSHKA_RIGHT_ARM_MEGA_PORT=/dev/serial/by-id/...
# ANUSHKA_HEAD_MEGA_PORT=/dev/serial/by-id/...
# ANUSHKA_BASE_MEGA_PORT=/dev/serial/by-id/...

# Legacy alias still works for the head Mega:
# ANUSHKA_AUX_MEGA_PORT=/dev/ttyACM2

OPENWEATHER_API_KEY=
